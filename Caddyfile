{$SITE_DOMAIN} {
    encode gzip

    header {
        # HTTPS only, for a year (browsers remember it)
        Strict-Transport-Security "max-age=31536000"
        # files are what they claim to be; no sniffing uploads into HTML/JS
        X-Content-Type-Options "nosniff"
        # the site can't be framed by others (clickjacking)
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        # where scripts, styles, images and requests may come from.
        # Clerk: dev instance (*.clerk.accounts.dev), a production instance (clerk.<domain>),
        # its bot check (Cloudflare Turnstile) and avatars; Google Fonts for the typography.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://clerk.{$SITE_DOMAIN} https://challenges.cloudflare.com https://*.protect.clerk.com; connect-src 'self' https://*.clerk.accounts.dev https://clerk.{$SITE_DOMAIN} https://*.protect.clerk.com:* https://clerk-telemetry.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://challenges.cloudflare.com https://*.protect.clerk.com https://*.clerk.accounts.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        # don't advertise the server software
        -Server
    }

    reverse_proxy frontend:8080
}

www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}
